{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "seed:local:generate": "node scripts/seed-local.mjs",
    "seed:local:apply": "wrangler d1 execute D1-select-pro --local --file=./scripts/seed-local.sql",
    "db:local": "wrangler d1 execute D1-select-pro --local",
    "db:migrate:local": "wrangler d1 migrations apply D1-select-pro --local",
    "db:migrate:staging": "wrangler d1 migrations apply select-pro-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply D1-select-pro --remote"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.10",
    "hono": "^4.12.33",
    "jose": "^6.2.8",
    "shared": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
